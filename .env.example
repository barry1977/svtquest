# Copie ce fichier en `.env` et renseigne tes valeurs.
# Ne commite jamais `.env` — les clés restent uniquement côté serveur.

# Obligatoire pour générer des QCM via OpenAI
OPENAI_API_KEY=sk-...

# Modèle utilisé pour la génération (économique et suffisant pour du QCM collège)
OPENAI_MODEL=gpt-4o-mini

# Nombre de questions générées par appel
OPENAI_QUESTION_COUNT=10

# Port du serveur API en local (npm run dev / npm start)
PORT=8787

# Port hôte Docker uniquement (docker compose) — distinct de PORT
# HOST_PORT=8080
